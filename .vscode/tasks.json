{
    "tasks": [
        {
            "label": "Assemble FiberContext",
            "type": "shell",
            "windows": {
                "command": "ml64.exe",
                "args": [
                    "/c",
                    "/Cx",
                    "/Fo", "${workspaceFolder}\\FiberJobSystem\\FiberContext_Win64.obj",
                    "${workspaceFolder}\\FiberJobSystem\\FiberContext_Win64.asm"
                ],
                "problemMatcher": ["$msCompile"]
            },
            "linux": {
                "command": "gcc",
                "args": [
                    "-c",
                    "${workspaceFolder}/FiberJobSystem/FiberContext_POSIX64.S",
                    "-o", "${workspaceFolder}/FiberJobSystem/FiberContext_POSIX64.o"
                ],
                "problemMatcher": ["$gcc"]
            },
            "osx": {
                "command": "clang",
                "args": [
                    "-c",
                    "${workspaceFolder}/FiberJobSystem/FiberContext_ARM64.S",
                    "-o", "${workspaceFolder}/FiberJobSystem/FiberContext_ARM64.o"
                ],
                "problemMatcher": ["$gcc"]
            },
            "group": "build"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "C:\\Program Files (x86)\\Microsoft Visual Studio\\18\\BuildTools\\VC\\Tools\\MSVC\\14.51.36231\\bin\\HostX64\\x64\\cl.exe",
            "args": [
                "/Zi", // Generate debug info
                "/EHsc",
                "/nologo",
                "/arch:AVX2",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "/std:c++latest",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build Engine (High-Performance Release)",
            "command": "C:\\Program Files (x86)\\Microsoft Visual Studio\\18\\BuildTools\\VC\\Tools\\MSVC\\14.51.36231\\bin\\HostX64\\x64\\cl.exe",
            "args": [
                // --- HIGH PERFORMANCE FLAGS ---
                "/O2",             // Maximum speed optimization
                "/arch:AVX2",      // Unlocks the 256-bit SIMD registers
                // "/arch:AVX512", // Unlocks the 512-bit SIMD registers (Implicitly includes AVX2, 256-bit SIMD registers)
                "/fp:fast",        // Allows the compiler to reorder floating-point math which is necessary for the compiler to generate FMA instructions (CRITICAL: Enables FMA and SIMD reordering).
                // "/openmp",         // Wakes up the other cores!
                "/Qpar",           // Enables the compiler's auto-parallelizer to assist std::for_each (Assists std::execution::par).
                "/std:c++latest",
                "/DNDEBUG",        // Disable asserts and debug code (Defines NDEBUG macro).
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",

                // --- 1. INCLUDE PATHS (Where the .h files are) ---
                "/I${workspaceFolder}\\thirdparty\\glfw-3.4.bin.WIN64\\include",
                "/I${workspaceFolder}\\thirdparty\\imgui-master",
                "/I${workspaceFolder}\\thirdparty\\imgui-master\\backends",
                "/I${workspaceFolder}\\thirdparty\\glad\\include",

                // --- 2. SOURCE FILES (GLAD2 + ImGui logic) ---
                "${workspaceFolder}\\*.cpp",
                "${workspaceFolder}\\thirdparty\\imgui-master\\imgui.cpp",
                "${workspaceFolder}\\thirdparty\\imgui-master\\imgui_draw.cpp",
                "${workspaceFolder}\\thirdparty\\imgui-master\\imgui_widgets.cpp",
                "${workspaceFolder}\\thirdparty\\imgui-master\\imgui_tables.cpp",
                "${workspaceFolder}\\thirdparty\\imgui-master\\imgui_demo.cpp",
                "${workspaceFolder}\\thirdparty\\imgui-master\\backends\\imgui_impl_glfw.cpp",
                "${workspaceFolder}\\thirdparty\\imgui-master\\backends\\imgui_impl_opengl3.cpp",
                "${workspaceFolder}\\thirdparty\\glad\\src\\gl.c",
                "${workspaceFolder}\\FiberJobSystem\\FiberContext_Win64.obj",

                //--- 3. LINKER SETTINGS (Connecting the .lib files) ---
                "/link",
                "/NODEFAULTLIB:LIBCMT",
                "/LIBPATH:${workspaceFolder}\\thirdparty\\glfw-3.4.bin.WIN64\\lib-vc2022",
                "glfw3.lib",
                "opengl32.lib",
                "gdi32.lib",
                "shell32.lib",
                "user32.lib",
                "winmm.lib", // Required for timeBeginPeriod (the high-res timer)
                "imm32.lib", // Required for ImGui text input
                "psapi.lib", // Required for RAM telemetry

                //--- 4. UNIVERSAL C RUNTIME. ---
                "msvcrt.lib", 
                "ucrt.lib",    
                "vcruntime.lib" 
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": ["Assemble FiberContext"],
            "detail": "Release build using cl.exe"
        },
        {
            "label": "C/C++: cl.exe build Debuggable Release",
            "command": "C:\\Program Files (x86)\\Microsoft Visual Studio\\18\\BuildTools\\VC\\Tools\\MSVC\\14.51.36231\\bin\\HostX64\\x64\\cl.exe",
            "args": [
                "/Zi",              // Generate complete debugging information (.pdb)
                "/O2",              // Keep the speed so the Segfault still triggers
                "/arch:AVX2",
                "/MD",             // Use Debug Runtime (better for catching heap corruption)
                "/std:c++latest",
                "/EHsc",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "/nologo",

                // --- 1. INCLUDE PATHS (Where the .h files are) ---
                "/I${workspaceFolder}\\thirdparty\\glfw-3.4.bin.WIN64\\include",
                "/I${workspaceFolder}\\thirdparty\\imgui-master",
                "/I${workspaceFolder}\\thirdparty\\imgui-master\\backends",
                "/I${workspaceFolder}\\thirdparty\\glad\\include",

                // --- 2. SOURCE FILES (GLAD2 + ImGui logic) ---
                "${workspaceFolder}\\*.cpp",
                "${workspaceFolder}\\thirdparty\\imgui-master\\imgui.cpp",
                "${workspaceFolder}\\thirdparty\\imgui-master\\imgui_draw.cpp",
                "${workspaceFolder}\\thirdparty\\imgui-master\\imgui_widgets.cpp",
                "${workspaceFolder}\\thirdparty\\imgui-master\\imgui_tables.cpp",
                "${workspaceFolder}\\thirdparty\\imgui-master\\imgui_demo.cpp",
                "${workspaceFolder}\\thirdparty\\imgui-master\\backends\\imgui_impl_glfw.cpp",
                "${workspaceFolder}\\thirdparty\\imgui-master\\backends\\imgui_impl_opengl3.cpp",
                "${workspaceFolder}\\thirdparty\\glad\\src\\gl.c",
                "${workspaceFolder}\\FiberJobSystem\\FiberContext_Win64.obj",

                
                "/link",
                "/DEBUG:FULL",      // Tells the linker to produce a PDB
                "/NODEFAULTLIB:LIBCMT",
                "/MACHINE:X64", // FORCE the linker to expect x64
                "/LIBPATH:${workspaceFolder}\\thirdparty\\glfw-3.4.bin.WIN64\\lib-vc2022",
                "glfw3dll.lib",
                "opengl32.lib", 
                "user32.lib", 
                "gdi32.lib", 
                "shell32.lib",
                "winmm.lib", // Required for timeBeginPeriod (the high-res timer)
                "imm32.lib", // Required for ImGui text input
                "psapi.lib" // Required for RAM telemetry
            ],
            "problemMatcher": ["$msCompile"],
            "group": { "kind": "build", "isDefault": false },
            "dependsOn": ["Assemble FiberContext"]
        }
    ],
    "version": "2.0.0"
}
